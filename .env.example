# Copie este archivo a .env y complete los valores. .env NO se sube al repositorio.

# ── Datos ─────────────────────────────────────────────
# Ruta del paquete canónico (se lee por variable, nunca incrustada).
CV_DATA_DIR=datos
# Fecha de corte por defecto del asistente (puerto Reloj del P1).
CV_CORTE=2026-10-31
# PostgreSQL con la extensión pgvector (datos del sistema + vectores del RAG).
# Si su Postgres local no tiene pgvector, levántelo con Docker:
#   docker run -d --name cv-pgvector -e POSTGRES_PASSWORD=cv_local -e POSTGRES_DB=credito_vecino -p 5433:5432 pgvector/pgvector:pg17
DATABASE_URL=postgres://postgres:cv_local@localhost:5433/credito_vecino

# ── OpenRouter (LLM del chat y embeddings del RAG) ────
# Clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo del chat: debe soportar tool calling. Verifique el ID exacto en https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-3.6-flash
# Modelo de embeddings y su dimensión (debe coincidir con la columna vector(N)).
# Si cambia el modelo, ajuste la dimensión y vuelva a correr: npm run rag:ingerir
# baai/bge-m3 es multilingüe (1024 dim) y es con el que se validaron las evals.
OPENROUTER_EMBEDDINGS_MODEL=baai/bge-m3
OPENROUTER_EMBEDDINGS_DIM=1024
