{
  "name": "microcredito-p1",
  "version": "1.0.0",
  "description": "Proyecto 1 — Arquitectura y diseño de componentes — Sistema de Gestión de Microcrédito — Crédito Vecino, S.A.",
  "main": "src/dominio/index.ts",
  "scripts": {
    "build": "tsc",
    "reporte": "tsx src/demo/reporte.ts",
    "demo": "tsx src/demo/consola.ts",
    "interactivo": "tsx src/demo/interactivo.ts",
    "demo:mora": "tsx src/demo/mora-escalonada.ts",
    "cargar": "tsx src/persistencia/cargar-cli.ts",
    "verificar": "tsx src/servicios/verificar.ts",
    "api": "tsx src/api/servidor.ts",
    "db:reset": "node -e \"require('fs').rmSync('.pgdata',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "microcredito",
    "arquitectura",
    "typecript",
    "domain"
  ],
  "author": "Tu Nombre Completo",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
